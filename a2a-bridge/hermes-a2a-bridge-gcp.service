[Unit]
Description=Private Hermes A2A Bridge
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=caozuohua99
WorkingDirectory=/home/caozuohua99/a2a-bridge
EnvironmentFile=/etc/hermes-a2a-bridge.env
EnvironmentFile=/home/caozuohua99/.hermes-lite/.env
EnvironmentFile=/home/caozuohua99/.hermes-lite/.env.lark
Environment=A2A_BIND=100.101.90.114
Environment=A2A_PORT=8765
Environment=A2A_AGENT_NAME=gcp-hermeslite
Environment=A2A_STATE_DIR=/home/caozuohua99/a2a-bridge/state
Environment=A2A_PEERS=100.87.159.14
Environment=A2A_ENABLE_TOOLS=false
Environment=A2A_ALLOWED_TOOLSETS=
Environment=HERMES_HOME=/home/caozuohua99/.hermes-lite
Environment=A2A_HERMES_EXEC=/home/caozuohua99/.hermes-lite/venv/bin/hermes
Environment='A2A_HERMES_ARGS=["--safe-mode","-z"]'
ExecStart=/usr/bin/python3 /home/caozuohua99/a2a-bridge/bridge.py
Restart=always
RestartSec=5
MemoryHigh=400M
MemoryMax=600M
CPUQuota=80%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/caozuohua99/.hermes-lite /home/caozuohua99/a2a-bridge/state
UMask=0077

[Install]
WantedBy=multi-user.target
