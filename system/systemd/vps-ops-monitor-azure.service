[Unit]
Description=VPS Sysops lightweight monitor (Azure)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=caozuohua
WorkingDirectory=/home/caozuohua/vps_sysops
Environment=VPS_PROFILE=azure
ExecStart=/usr/bin/bash /home/caozuohua/vps_sysops/scripts/03_monitor.sh
TimeoutStartSec=30s
CPUQuota=10%
MemoryMax=128M
TasksMax=32
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
