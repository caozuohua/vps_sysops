[Unit]
Description=Mem0 PostgreSQL low-resource backup (AWS)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/vps_sysops
ExecStart=/usr/bin/flock -n /run/vps-ops/mem0-backup.lock /usr/bin/bash /opt/vps_sysops/scripts/mem0_backup.sh backup --format json
TimeoutStartSec=20min
CPUQuota=25%
MemoryMax=256M
TasksMax=64
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/backups/vps-sysops/mem0
RuntimeDirectory=vps-ops
